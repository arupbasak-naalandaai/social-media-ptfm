# ─────────────────────────────────────────────────────────────────────────────
# Bootstrap environment only. Platform tokens, Slack tokens and AI keys are
# entered in Settings and stored encrypted in Postgres, never here.
# Local dev: copy to `.env` at the repo root (all apps read it).
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string (api, worker, prisma CLI).
# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_inbox

# better-auth signing secret, 32+ random bytes (api). Generate: pnpm gen:key
BETTER_AUTH_SECRET=

# Public URL of the web app (api, worker, web). Auth cookies live on this origin,
# so better-auth's base URL is the web URL, not the api URL.
WEB_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client for SIGN-IN only (api). Separate from the Google Business
# Profile connection client, which is entered in Settings.
# Authorized JavaScript origins: http://localhost:3000, http://localhost
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same value as GOOGLE_CLIENT_ID; exposed to the browser for Google One Tap (web, build time).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional. Restricts who can become the FIRST owner (before any allowlist exists).
# Comma-separated emails and/or domains, e.g. "me@example.com, example.com".
# Empty = the first Google account to sign in becomes owner. Set this on any public deploy.
BOOTSTRAP_OWNER_EMAILS=

# LOCAL DEVELOPMENT ONLY. "true" lets you browse the app signed out as a virtual preview
# user (nothing is written to the DB; a real sign-in still takes precedence). The api refuses
# to start with this on when NODE_ENV=production or on Railway.
DEV_AUTH_BYPASS=false
# Role of the preview user: owner | admin | member
DEV_AUTH_ROLE=owner

# AES-256-GCM key for secrets stored in Postgres, 32 bytes base64 (api, worker). pnpm gen:key
ENCRYPTION_KEY=

# Public URL of the api service: platform webhooks, Slack, platform OAuth callbacks (api, worker).
# Railway: https://${{api.RAILWAY_PUBLIC_DOMAIN}}
API_PUBLIC_URL=http://localhost:3001

# Private URL the web server uses to reach the api (web, build + runtime).
# Railway: http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
API_INTERNAL_URL=http://localhost:3001

# Ports (Railway injects PORT). Local defaults: web 3000, api 3001, worker 3002.
# If 3000 is taken locally, set WEB_PORT and update WEB_URL/BETTER_AUTH_URL + the Google client to match.
WEB_PORT=3000
API_PORT=3001
WORKER_PORT=3002

# trace | debug | info | warn | error
LOG_LEVEL=info

# Throwaway database for integration tests (auth hooks). Tests are skipped when unset.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_inbox_test
