{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV", "LOG_LEVEL"],
  "globalPassThroughEnv": [
    "PORT",
    "WEB_PORT",
    "API_PORT",
    "WORKER_PORT",
    "WEB_URL",
    "BETTER_AUTH_URL",
    "API_PUBLIC_URL",
    "API_INTERNAL_URL",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "ENCRYPTION_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "BOOTSTRAP_OWNER_EMAILS",
    "LOG_PRETTY",
    "DEV_AUTH_BYPASS",
    "DEV_AUTH_ROLE"
  ],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^generate", "generate", "^build"],
      "env": ["API_INTERNAL_URL", "NEXT_PUBLIC_*", "WEB_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^generate", "generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^generate", "generate"]
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate"]
    },
    "test": {
      "dependsOn": ["^generate", "generate"]
    }
  }
}
