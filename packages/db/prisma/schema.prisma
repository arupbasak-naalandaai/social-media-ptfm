// Unified Social Inbox: Prisma schema.
// Auth tables (User, Session, Account, Verification, Organization, Member, Invitation)
// are generated by the better-auth CLI (`pnpm auth:generate`) and kept below the app models.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── App models ────────────────────────────────────────────────────────────────

/// One row per organization. Each section is a JSON blob validated by zod in @inbox/core.
model Settings {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version        Int          @default(1)
  general        Json         @default("{}")
  connections    Json         @default("{}")
  sync           Json         @default("{}")
  filters        Json         @default("{}")
  ai             Json         @default("{}")
  replies        Json         @default("{}")
  slack          Json         @default("{}")
  notifications  Json         @default("{}")
  data           Json         @default("{}")
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("settings")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  action         String
  entity         String
  entityId       String?
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_log")
}

// ─── Inbox domain ──────────────────────────────────────────────────────────────

enum Platform {
  google_business
  facebook
  instagram
  youtube
  linkedin
}

enum AccountKind {
  gbp_location
  fb_page
  ig_account
  yt_channel
  li_org
}

enum AccountStatus {
  connected
  expiring
  error
  disconnected
}

enum ItemType {
  review
  comment
  dm
}

enum ItemStatus {
  new
  pending
  replied
  resolved
  ignored
  failed
  filtered
  archived
}

enum Priority {
  low
  normal
  high
  urgent
}

enum SyncMode {
  webhook
  polling
  webhook_reconcile
}

enum ReplySource {
  ai_draft
  manual_dashboard
  slack_button
  slack_send_prefix
  auto_reply
}

enum ReplyStatus {
  queued
  sending
  sent
  failed
}

/// A connected page / IG account / GBP location / YouTube channel / LinkedIn org.
model PlatformAccount {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform        Platform
  kind            AccountKind
  externalId      String
  displayName     String
  avatarUrl       String?
  /// IG account → linked FB page; GBP location → GBP account.
  parentAccountId String?
  /// AES-256-GCM ciphertext (packages/core crypto). Never returned to the browser.
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  scopes          String[]      @default([])
  status          AccountStatus @default(connected)
  lastError       String?
  lastErrorAt     DateTime?
  /// "Which pages/locations/channels to include."
  included        Boolean       @default(true)
  meta            Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items         Item[]
  conversations Conversation[]
  syncStates    SyncState[]

  @@unique([organizationId, platform, externalId])
  @@map("platform_account")
}

/// Per account and stream (reviews | comments | dms) sync bookkeeping; drives the scheduler.
model SyncState {
  id                  String          @id @default(cuid())
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformAccountId   String
  platformAccount     PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  stream              String
  mode                SyncMode
  intervalSeconds     Int
  cursor              String?
  lastRunAt           DateTime?
  nextRunAt           DateTime
  lastSuccessAt       DateTime?
  consecutiveFailures Int             @default(0)
  quotaUsedToday      Int             @default(0)
  quotaDay            DateTime?
  lastError           String?
  backfillDays        Int             @default(30)
  /// Scheduler lease: set while a poll job is in flight.
  lockedUntil         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([platformAccountId, stream])
  @@index([nextRunAt])
  @@index([organizationId])
  @@map("sync_state")
}

/// Raw webhook payloads: de-duplication, debugging and replay.
model WebhookEvent {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         String
  dedupeKey      String?
  headers        Json          @default("{}")
  payload        Json
  signatureValid Boolean
  receivedAt     DateTime      @default(now())
  processedAt    DateTime?
  error          String?
  attempts       Int           @default(0)

  @@unique([source, dedupeKey])
  @@index([receivedAt])
  @@index([organizationId, receivedAt(sort: Desc)])
  @@map("webhook_event")
}

/// One review, comment, or DM message.
model Item {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform          Platform
  platformAccountId String
  platformAccount   PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  type              ItemType
  externalId        String
  parentExternalId  String?
  conversationId    String?
  conversation      Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// Groups a DM conversation, a comment with its replies, or a review (see pipeline threads.ts).
  threadKey         String?
  /// New activity in a thread we already replied to or resolved: shown under Follow-ups.
  isFollowUp        Boolean         @default(false)
  postId            String?
  postUrl           String?
  /// The platform's permalink to this item, when its API returns one.
  externalUrl       String?
  postTitle         String?
  postPublishedAt   DateTime?
  authorName        String?
  authorHandle      String?
  authorId          String?
  authorAvatarUrl   String?
  isOwnAccount      Boolean         @default(false)
  isReplyToOurReply Boolean         @default(false)
  text              String?
  rating            Int?
  language          String?
  eventKind         String          @default("created")
  receivedAt        DateTime        @default(now())
  platformCreatedAt DateTime?
  platformUpdatedAt DateTime?
  status            ItemStatus      @default(new)
  priority          Priority        @default(normal)
  tags              String[]        @default([])
  matchedRuleIds    String[]        @default([])
  dryRunRuleIds     String[]        @default([])
  /// Rule name(s) shown in the Filtered tab.
  filterReason      String?
  /// Set when a person restored/archived the item by hand: re-filtering won't change its status.
  manualOverride    Boolean         @default(false)
  lastFilteredAt    DateTime?
  aiSpamScore       Float?
  aiSentiment       String?
  aiToxicity        Float?
  aiDraftsAllowed   Boolean         @default(true)
  requireApproval   Boolean         @default(true)
  slackChannelId    String?
  slackTs           String?
  skipSlack         Boolean         @default(false)
  resolvedAt        DateTime?
  resolvedById      String?
  /// Last normalized payload, for debugging.
  raw               Json            @default("{}")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  aiDrafts    AiDraft[]
  replies     Reply[]
  ruleMatches RuleMatch[]

  @@unique([organizationId, platform, platformAccountId, externalId])
  @@index([organizationId, status, receivedAt(sort: Desc)])
  @@index([organizationId, platform, type])
  @@index([organizationId, threadKey])
  @@index([organizationId, isFollowUp, status])
  @@index([conversationId])
  @@map("item")
}

/// One DM thread.
model Conversation {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform              Platform
  platformAccountId     String
  platformAccount       PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  externalThreadId      String
  customerId            String
  customerName          String?
  /// Drives the DM reply window (24 h on Meta).
  customerLastMessageAt DateTime?
  slackTs               String?
  status                ItemStatus      @default(new)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  items Item[]

  @@unique([organizationId, platform, platformAccountId, externalThreadId])
  @@map("conversation")
}

model AiDraft {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text           String
  provider       String
  model          String
  chosen         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([itemId])
  @@map("ai_draft")
}

model Reply {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text            String
  source          ReplySource
  sentById        String?
  status          ReplyStatus  @default(queued)
  externalReplyId String?
  error           String?
  sentAt          DateTime?
  /// Prevents a double public post when a send-reply job is retried.
  idempotencyKey  String       @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([itemId])
  @@map("reply")
}

/// Filter rules; JSON columns are validated by zod (packages/core/filters).
model FilterRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  enabled        Boolean      @default(true)
  priority       Int
  stopProcessing Boolean      @default(false)
  /// Platform[] | "all"
  platforms      Json
  /// ItemType[] | "all"
  itemTypes      Json
  /// ConditionGroup
  conditions     Json
  /// RuleAction[]
  actions        Json
  dryRun         Boolean      @default(false)
  isDefault      Boolean      @default(false)
  /// Stable key for seeded defaults, e.g. "drop_own_activity".
  defaultKey     String?
  /// Admin-only, off by default (Phase 4+).
  autoReply      Boolean      @default(false)
  createdById    String?
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  matches RuleMatch[]

  @@unique([organizationId, defaultKey])
  @@index([organizationId, priority])
  @@map("filter_rule")
}

/// Each time a rule matched an item (for "matches in the last 7 days").
model RuleMatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleId         String
  rule           FilterRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  dryRun         Boolean      @default(false)
  matchedAt      DateTime     @default(now())

  @@unique([ruleId, itemId])
  @@index([organizationId, ruleId, matchedAt])
  @@map("rule_match")
}

/// Blocklist / allowlist / spam keywords / trusted domains in one table.
model ListEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// blocklist | allowlist | spam_keywords | trusted_domains
  list           String
  /// author_id | author_handle | keyword | domain
  kind           String
  value          String
  /// null = all platforms
  platform       Platform?
  note           String?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, list, kind, value, platform])
  @@index([organizationId, list])
  @@map("list_entry")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id               String            @id
  name             String
  slug             String
  logo             String?
  createdAt        DateTime
  metadata         String?
  members          Member[]
  invitations      Invitation[]
  // App relations (re-add if `pnpm auth:generate` drops them)
  settings         Settings?
  auditLogs        AuditLog[]
  platformAccounts PlatformAccount[]
  syncStates       SyncState[]
  webhookEvents    WebhookEvent[]
  items            Item[]
  conversations    Conversation[]
  aiDrafts         AiDraft[]
  replies          Reply[]
  filterRules      FilterRule[]
  ruleMatches      RuleMatch[]
  listEntries      ListEntry[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
