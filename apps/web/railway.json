{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@inbox/web...",
    "watchPatterns": ["apps/web/**", "packages/core/**", "packages/config/**", "pnpm-lock.yaml", "package.json", "turbo.json"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @inbox/web start",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
