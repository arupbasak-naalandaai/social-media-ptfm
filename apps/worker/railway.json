{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@inbox/worker...",
    "watchPatterns": ["apps/worker/**", "packages/**", "pnpm-lock.yaml", "package.json", "turbo.json"]
  },
  "deploy": {
    "startCommand": "node apps/worker/dist/index.mjs",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
