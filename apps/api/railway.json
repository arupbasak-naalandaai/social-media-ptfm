{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@inbox/api...",
    "watchPatterns": ["apps/api/**", "packages/**", "pnpm-lock.yaml", "package.json", "turbo.json"]
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @inbox/db migrate:deploy"],
    "startCommand": "node apps/api/dist/index.mjs",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
