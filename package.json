{
  "name": "social-inbox",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @inbox/db generate",
    "db:migrate": "pnpm --filter @inbox/db migrate:dev",
    "db:deploy": "pnpm --filter @inbox/db migrate:deploy",
    "db:seed": "pnpm --filter @inbox/pipeline seed",
    "db:studio": "pnpm --filter @inbox/db studio",
    "auth:generate": "pnpm --filter @inbox/auth schema:generate",
    "gen:key": "node scripts/gen-encryption-key.mjs"
  },
  "devDependencies": {
    "prettier": "~3.10.1",
    "turbo": "~2.11.11",
    "typescript": "6.0.3"
  }
}
